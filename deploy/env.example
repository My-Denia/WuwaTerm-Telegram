TELEGRAM_BOT_TOKEN=
OWNER_USER_ID=

# Optional OpenAI-compatible translation service.
WUWATERM_OPENAI_BASE_URL=
WUWATERM_OPENAI_API_KEY=
WUWATERM_OPENAI_MODEL=

WUWATERM_LOG_LEVEL=INFO
WUWATERM_LLM_TIMEOUT_SECONDS=45
WUWATERM_LLM_MAX_CONCURRENCY=4
# Provider reasoning for translation requests, one setting per direction
# (Chinese into English, English into Chinese): disabled, omit, low, high,
# or auto (en->zh opt-in added in Core 0.11.0+, supported on Core >=0.16.0).
# omit sends no field, so the provider default applies, which on DeepSeek is
# high-effort thinking. disabled removes thinking; auto on en->zh resolves per
# request (disabled at >=4 locks or >=25 paragraphs, low otherwise) with one
# shared corrective call budget across paragraph repair or timeout fallback.
# Default into English stays disabled; default into Chinese stays omit.
# Known regression with disabled into English: a character-mechanic name that
# contains a one-character resonator name may be rendered with the resonator
# name; set WUWATERM_TRANSLATION_THINKING_ZH_EN=omit to restore the previous
# behaviour. A blank or unknown value (the latter logs a warning) uses that
# direction's default. Translation requests only (/tr, /sentence, channel
# auto-translation); Core reads them on every request.
WUWATERM_TRANSLATION_THINKING_ZH_EN=disabled
WUWATERM_TRANSLATION_THINKING_EN_ZH=omit
WUWATERM_RATE_LIMIT_PER_MINUTE=10
WUWATERM_REDACTION_SECRET=
WUWATERM_TR_REJECT_SILENT=0
# WUWATERM_GROUP_TR_REJECT_TEXT=
# WUWATERM_PRIVATE_TR_REJECT_TEXT=

WUWATERM_CHANNEL_AUTOTRANSLATE=1
WUWATERM_CHANNEL_MIN_CJK=1
WUWATERM_CHANNEL_MIN_LATIN=2
WUWATERM_CHANNEL_TEXT_LIMIT=4096
WUWATERM_CHANNEL_CAPTION_LIMIT=1024
WUWATERM_CHANNEL_MAX_PENDING=16
WUWATERM_CHANNEL_LLM_CALLS_PER_MINUTE=60
WUWATERM_CHANNEL_MAX_AGE_SECONDS=86400
# Bounded recoverable channel retry queue (pure in-memory by default).
# Set WUWATERM_CHANNEL_QUEUE_PERSIST=1 only if you explicitly want 0600
# disk persistence bounded by TTL and max size (text is wiped on completion/expiry).
WUWATERM_CHANNEL_QUEUE_MAX_SIZE=128
WUWATERM_CHANNEL_QUEUE_TTL_SECONDS=3600
WUWATERM_CHANNEL_QUEUE_MAX_ATTEMPTS=5
WUWATERM_CHANNEL_QUEUE_PERSIST=0
# WUWATERM_CHANNEL_QUEUE_PATH=state/channel_queue.json

# Core backend execution mode (fail-closed):
# - auto (default when unset): use HTTP Core when WUWATERM_CORE_API_URL is set,
#   otherwise fall back to the embedded local SQLite backend.
# - http (recommended for production): pure HTTP Core mode. Skips local
#   terms.db verification/loading completely and fails closed at startup if
#   WUWATERM_CORE_API_URL is missing or invalid. Capabilities are negotiated
#   via GET /v1/capabilities.
# - local (legacy embedded fallback): uses local terms.db + in-process Core
#   translator; fails closed if WUWATERM_CORE_API_URL is also set.
WUWATERM_CORE_MODE=http
WUWATERM_CORE_API_URL=http://127.0.0.1:8000
WUWATERM_CORE_API_TOKEN=
WUWATERM_CORE_API_TIMEOUT_SECONDS=45

# Compose sets WUWATERM_STATE_DIR=/app/state (no local terms.db mount needed in
# pure HTTP mode). For legacy local-DB fallback, set WUWATERM_CORE_MODE=local,
# unset WUWATERM_CORE_API_URL, and mount data/terms.db.
# Outside Compose, these optional paths override the normal state location.
# WUWATERM_STATE_DIR=state
# WUWATERM_SETTINGS_PATH=state/chat_settings.json
# WUWATERM_CHANNEL_REPLY_INDEX_PATH=state/channel_replies.json

# /review's model track is an experimental Core feature and is off by default.
# Leave it unset for production and public bots; /review then gives dictionary
# term findings only. A self-hosted bot with a configured model may opt in.
# WUWATERM_SEMANTIC_REVIEW_ENABLED=1
